# Standard Library Imports
from collections.abc import Mapping
from typing import Protocol

# pytkwrap Package Imports
from pytkwrap.gtk3._libs import Gtk as Gtk
from pytkwrap.gtk3.mixins import GTK3WidgetAttributes as GTK3WidgetAttributes
from pytkwrap.gtk3.mixins import GTK3WidgetProperties as GTK3WidgetProperties

class _ActionBarHost(Protocol):
    dic_attributes: GTK3WidgetAttributes
    dic_handler_id: dict[str, int]
    dic_properties: GTK3WidgetProperties
    def do_set_properties(
        self, properties: Mapping[str, object] | list[list | tuple]
    ) -> None: ...
    def do_add_child(self, child: Gtk.Widget, start: bool = True) -> None: ...
    def set_center_widget(self, center_widget: Gtk.Widget | None) -> None: ...
    def pack_end(self, child: Gtk.Widget) -> None: ...
    def pack_start(self, child: Gtk.Widget) -> None: ...

class _HeaderBarHost(Protocol):
    dic_properties: GTK3WidgetProperties
    def do_set_properties(
        self, properties: Mapping[str, object] | list[list | tuple]
    ) -> None: ...
    def do_add_child(self, child: Gtk.Widget, start: bool = True) -> None: ...
    def set_custom_title(self, title: str | None): ...
    def set_decoration_layout(self, decoration_layout): ...
    def set_has_subtitle(self, has_subtitle: bool): ...
    def set_show_close_button(self, show_close_button: bool): ...
    def set_subtitle(self, subtitle: str | None): ...
    def set_title(self, title: str | None): ...
    def pack_end(self, child: Gtk.Widget) -> None: ...
    def pack_start(self, child: Gtk.Widget) -> None: ...
    def set_property(self, property_name: str, value): ...
