class _ListBoxHost(Protocol):
    dic_handler_id: dict[str, int]
    dic_properties: GTK3WidgetProperties
    def do_set_properties(
        self,
        properties: (
            Mapping[str, object] | Sequence[list[str | object] | tuple[str, object]]
        ),
    ) -> None: ...
    def do_add_child(self, child: Gtk.Widget, position: int | None = None) -> None: ...
    def do_get_row(
        self, index: int | None = None, y: int | None = None
    ) -> Gtk.ListBoxRow | None: ...
    def do_get_selected(self) -> list[Gtk.ListBoxRow]: ...
    def do_select_row(self, row: Gtk.ListBoxRow | None) -> None: ...
    def do_unselect_row(self, row: Gtk.ListBoxRow | None) -> None: ...
    def get_row_at_index(self, index: int) -> Gtk.ListBoxRow | None: ...
    def get_row_at_y(self, y: int) -> Gtk.ListBoxRow | None: ...
    def get_selected_rows(self) -> list[Gtk.ListBoxRow]: ...
    def insert(self, child: Gtk.Widget, position: int) -> None: ...
    def prepend(self, child: Gtk.Widget) -> None: ...
    def select_all(self) -> None: ...
    def select_row(self, row: Gtk.ListBoxRow) -> None: ...
    def set_activate_on_single_click(self, activate_on_single_click: bool) -> None: ...
    def set_adjustment(self, adjustment: Gtk.Adjustment) -> None: ...
    def set_selection_mode(self, selection_mode: Gtk.SelectionMode) -> None: ...
    def unselect_all(self) -> None: ...
    def unselect_row(self, row: Gtk.ListBoxRow) -> None: ...

class _PanedHost(Protocol):
    dic_attributes: GTK3WidgetAttributes
    dic_handler_id: dict[str, int]
    dic_properties: GTK3WidgetProperties
    def do_set_properties(
        self,
        properties: (
            Mapping[str, object] | Sequence[list[str | object] | tuple[str, object]]
        ),
    ) -> None: ...
    def do_add_child(
        self, child: Gtk.Widget, resize: bool, shrink: bool, position: int = 1
    ) -> None: ...
    @property
    def children(self) -> tuple[Gtk.Widget, Gtk.Widget]: ...
    @property
    def handle_window(self) -> Gdk.Window: ...
    def get_child1(self) -> Gtk.Widget: ...
    def get_child2(self) -> Gtk.Widget: ...
    def get_handle_window(self) -> Gdk.Window: ...
    def pack1(self, child: Gtk.Widget, resize: bool, shrink: bool) -> None: ...
    def pack2(self, child: Gtk.Widget, resize: bool, shrink: bool) -> None: ...
    def set_position(self, position: int) -> None: ...
    def set_property(self, property_name: str, value) -> None: ...
    def set_wide_handle(self, wide_handle: bool) -> None: ...
