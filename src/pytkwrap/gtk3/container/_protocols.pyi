    dic_properties: GTK3WidgetProperties
    def do_set_properties(
        self,
        properties: (
            Mapping[str, object] | Sequence[list[str | object] | tuple[str, object]]
        ),
    ) -> None: ...
    def set_expanded(self, expanded: bool) -> None: ...
